# ───────── Servidor ─────────
PORT=3200
# URL pública HTTPS donde queda el servidor (para la documentación del webhook)
PUBLIC_URL=https://agenda.valenciastetic.com
# Carpeta de datos (SQLite). En producción usar un volumen persistente.
DATA_DIR=./data

# ───────── Panel ─────────
# Clave del panel del equipo (/panel). Obligatoria en producción.
PANEL_PASSWORD=cambia-esta-clave
# Secreto para firmar la sesión del panel (cadena larga aleatoria)
SESSION_SECRET=cambia-este-secreto-largo
# Simulador de chat en /simulador (1 = activo). Úsalo para probar sin WhatsApp.
SIMULADOR=1

# ───────── WhatsApp Cloud API (Meta) ─────────
# Si WA_TOKEN está vacío el sistema corre en MODO SIMULACIÓN (no envía nada a WhatsApp).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Token que tú inventas y pegas en Meta al configurar el webhook
WA_VERIFY_TOKEN=valencia-stetic-verify
# App Secret de la app de Meta (para validar la firma X-Hub-Signature-256)
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Idioma de las plantillas aprobadas
WA_TEMPLATE_LANG=es

# ───────── Conversions API (señal de citas/ventas a Meta Ads) ─────────
# Dataset (conjunto de datos) vinculado a la WABA en el Administrador de eventos
META_DATASET_ID=
# Token con permiso ads_management / whatsapp_business_management (puede ser el mismo WA_TOKEN de usuario del sistema)
META_CAPI_TOKEN=
# Nombres de evento (ver README)
CAPI_EVENT_CITA=LeadSubmitted
CAPI_EVENT_ASISTIO=Purchase

# ───────── Equipo ─────────
# Números del equipo que reciben aviso de nuevas citas / casos para asesora (formato 57XXXXXXXXXX, separados por coma)
STAFF_WA_NUMBERS=

# ───────── IA opcional (respuestas a preguntas libres) ─────────
# Si está vacío, el bot funciona 100 % con reglas y menús.
ANTHROPIC_API_KEY=
# Modelo. Por defecto claude-opus-5-5. Para bajar costo puedes usar claude-haiku-5-5.
CLAUDE_MODEL=claude-opus-5-5

# ───────── Página pública de reservas (/reservas) ─────────
# Número público de WhatsApp (solo dígitos con indicativo, ej. 573001234567) para los botones "Escríbenos" de la página.
# Si queda vacío, se usa config/negocio.json → web.whatsapp; si tampoco hay, el botón de WhatsApp no se muestra.
WA_PUBLIC_NUMBER=
# 1 cuando el servidor está detrás de un proxy HTTPS (Railway/Render/Caddy): permite limitar abusos por IP real.
TRUST_PROXY=0
